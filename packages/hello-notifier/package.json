{
  "name": "@camstack/addon-hello-notifier",
  "version": "0.1.0",
  "description": "Single-addon example: a log-destination provider with a keychain password setting.",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "log-destination"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "camstack": {
    "displayName": "Hello Notifier",
    "description": "Example package that ships one addon.",
    "addons": [
      {
        "id": "hello-notifier",
        "name": "Hello Notifier",
        "version": "0.1.0",
        "description": "Accepts log lines and keeps a keychain token on its settings form.",
        "entry": "./dist/index.js",
        "icon": "assets/icon.svg",
        "color": "#0f766e",
        "category": "messaging",
        "instanceMode": "unique",
        "protected": false,
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "log-destination",
            "autoActivate": false,
            "optional": false
          }
        ],
        "defaultConfig": {
          "endpoint": "",
          "token": ""
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "validate": "tsx ../../scripts/validate-manifests.ts",
    "deploy": "camstack deploy ."
  },
  "peerDependencies": {
    "@camstack/types": "*"
  },
  "devDependencies": {
    "@camstack/types": "1.2.415",
    "@trpc/client": "^11.16.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.11",
    "vitest": "^3.2.4"
  }
}
